{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "gateway": {
      "root": "backend/gateway",
      "framework": "express",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "bindings": [
        { "type": "service", "service": "auth", "format": "url", "env": "AUTH_SERVICE" },
        { "type": "service", "service": "chat", "format": "url", "env": "CHAT_SERVICE" },
        { "type": "service", "service": "agent", "format": "url", "env": "AGENT_SERVICE" },
        { "type": "service", "service": "billing", "format": "url", "env": "BILLING_SERVICE" }
      ]
    },
    "agent": {
      "root": "backend/services/agent",
      "framework": "express",
      "installCommand": "npm install",
      "buildCommand": "npm run build"
    },
    "auth": {
      "root": "backend/services/auth",
      "framework": "express",
      "installCommand": "npm install",
      "buildCommand": "npm run build"
    },
    "billing": {
      "root": "backend/services/billing",
      "framework": "express",
      "installCommand": "npm install",
      "buildCommand": "npm run build"
    },
    "chat": {
      "root": "backend/services/chat",
      "framework": "express",
      "installCommand": "npm install",
      "buildCommand": "npm run build"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "gateway" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}